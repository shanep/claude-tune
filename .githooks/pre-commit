#!/bin/sh
# Validate the plugin, then typecheck, test, and make sure dist/ matches the
# source, since the plugin runs the committed bundle. Every push to master
# goes straight to every machine with tune@shanep, so this is the real gate.
# scripts/validate.mjs fails on anything validate reports except the missing
# version, and skips when claude is not installed.
set -e
node scripts/validate.mjs
exec npm run -s check
