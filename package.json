{
  "name": "claude-tune",
  "version": "0.1.0",
  "private": true,
  "description": "A Claude Code plugin that reads your session transcripts and shows where your tokens go and what to change.",
  "license": "MIT",
  "author": "Shane Panter",
  "type": "module",
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "node scripts/validate.mjs",
    "check": "npm run -s typecheck && npm test && npm run -s build && git diff --exit-code -- dist",
    "tune": "node dist/tune.cjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
